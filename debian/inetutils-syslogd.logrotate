/var/log/syslog
/var/log/daemon.log
{
   rotate 7
   daily
   missingok
   notifempty
   compress
   delaycompress
   sharedscripts
   postrotate
      service inetutils-syslogd reload >/dev/null
   endscript
}

/var/log/auth.log
/var/log/cron.log
/var/log/debug
/var/log/kern.log
/var/log/mail.err
/var/log/mail.info
/var/log/mail.log
/var/log/mail.warn
/var/log/messages
/var/log/user.log
{
   rotate 4
   weekly
   missingok
   notifempty
   compress
   delaycompress
   sharedscripts
   postrotate
      service inetutils-syslogd reload >/dev/null
   endscript
}
